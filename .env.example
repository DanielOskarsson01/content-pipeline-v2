PORT=3001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key_here
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
MODULES_PATH=../content-pipeline-modules-v2
# tools.storage (Unit #46). ASSET_PUBLIC_BASE is F1-critical: a stable, re-pointable
# custom-domain/CDN host in front of the assets bucket — NEVER the *.supabase.co native
# host. tools.storage.put() THROWS if this is unset or points at supabase.co (the native
# host would break every published asset on the future R2 migration). Storage reuses
# SUPABASE_URL/SUPABASE_KEY (same project, same service-role key).
ASSET_PUBLIC_BASE=https://cdn.your-domain.com/assets
ASSET_BUCKET=assets
# tools.storage Cloudinary backend (Unit D12 swap). Bytes live in Cloudinary; asset METADATA
# stays in Postgres (SUPABASE_URL/KEY). All pipeline assets go under the "pipline" folder (sic).
# Server-side signed uploads use the API secret — NEVER commit real values, NEVER log them.
# Cloud name is public (it is in every delivery URL); the key + secret are secrets.
CLOUDINARY_CLOUD_NAME=dj39tfdpt
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
