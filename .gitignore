# Dependencies
node_modules/

# Environment variables (contains secrets)
.env
.env.local
.env.development
.env.*.local

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
logs/
*.log
npm-debug.log*

# Build output
dist/
build/
public-react/

# Vite
*.local
.vite/

# Test coverage
coverage/

# Temporary files
tmp/
temp/
*.tmp

# Package manager locks (optional - some teams commit these)
# package-lock.json

# Runtime data (CSV uploads, etc.)
data/

# Secrets and credentials
*.pem
*.key
credentials.json
secrets.json

# Diagnostic SQL notebooks — read-only investigation queries, not schema/migrations.
# The diagnostic_* prefix marks them as untracked-by-design.
sql/diagnostic_*.sql
